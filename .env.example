# Copy to .env and fill in. Real environment variables take precedence over this file.

# Model as "provider:model" (any id accepted by LangChain's init_chat_model).
# Install the matching provider extra:  uv sync --extra anthropic  |  uv sync --extra openai
FILE_ORGANIZER_MODEL=anthropic:claude-sonnet-4-5
# FILE_ORGANIZER_MODEL=openai:gpt-4.1

# Cheap model that summarizes old messages in long sessions (default: claude-haiku-5-5
# for anthropic, gpt-4.1-mini for openai, else the main model).
# FILE_ORGANIZER_SUMMARY_MODEL=anthropic:claude-haiku-5-5
# Summarize once the history reaches about this many tokens (default 60000).
# FILE_ORGANIZER_SUMMARIZE_AT=60000
# Hard cap per LLM request, at least twice the above (default 150000).
# FILE_ORGANIZER_MAX_CONTEXT_TOKENS=150000

# API key for the provider you use.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Logging (written in the background to a file, never to the terminal).
# FILE_ORGANIZER_LOG_FILE=.file-organizer.log
# FILE_ORGANIZER_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL
# FILE_ORGANIZER_LOG_FORMAT=text         # text (for people) | json (for ELK, Datadog, Loki, ...)

# Saved agent state for resuming an interrupted session, plus the store of finalized
# decisions (SQLite file).
# FILE_ORGANIZER_STATE_DB=.file-organizer.sqlite
